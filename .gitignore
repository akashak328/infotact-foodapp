# ============================================================
# .gitignore — Infotact Food App
# ============================================================

# ── Environment & Secrets ────────────────────────────────────
.env
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Local Spring Boot properties (has real secrets)
application-local.properties

# ── Java / Maven ─────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── Node / React ─────────────────────────────────────────────
node_modules/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
.npm

# ── IDEs & Editors ────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Docker ────────────────────────────────────────────────────
# Keep docker-compose.yml but ignore override files
docker-compose.override.yml

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
spring.log

# ── OS files ─────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
