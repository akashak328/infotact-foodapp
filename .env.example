# ============================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your values.
# The .env file is in .gitignore — never commit it.
# ============================================================

# MongoDB
SPRING_DATA_MONGODB_URI=mongodb://mongodb:27017/infotact_foodapp

# JWT — generate a strong random secret (min 32 characters)
# Example command to generate: openssl rand -hex 32
APP_JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
APP_JWT_EXPIRATION=86400000

# CORS — frontend URL
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
